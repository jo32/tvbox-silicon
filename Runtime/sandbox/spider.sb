;; Seatbelt profile for the macOS spider child processes (Java / Node / Python).
;;
;; Attacker-controlled subscription spider code runs inside these runtimes. Even with
;; arbitrary code execution in a runtime, this kernel-enforced profile must prevent the
;; code from (a) reading the contents of user files outside the app's own caches,
;; (b) writing anywhere else, or (c) executing other programs. Functionality preserved:
;; outbound HTTP(S), the per-session cache/profile directories, and the loopback proxy.
;;
;; Applied via `sandbox-exec -f spider.sb -D KEY=value ... <interpreter> <args>`.
;; All parameters are required and MUST be canonical (symlink-resolved) absolute paths,
;; because Seatbelt matches canonical paths:
;;   RESOURCES   app bundle Resources dir (the interpreter, its libs, host scripts)
;;   CACHE_ROOT  ~/Library/Caches/<bundle-id>  (the host working root)
;;   JOB         this request's session directory (also the process TMPDIR and cwd)
;;   PROFILE     this source's persistent profile directory
;;   ACCOUNTS    the saved cloud-drive sign-ins file (read only; the host hands it to spiders)
;;   HOME        the user's home directory (everything under it is cut off by default)

(version 1)
(deny default)
;; Flip to (debug deny) while tuning to log every denial to the system log.

;; Apple's dyld bootstrap rules (shared cache in the Cryptex, /usr/lib/dyld, the mapping
;; syscalls). Without these a deny-default process cannot even launch: dyld aborts before
;; main. Shipped at a fixed path on every supported macOS.
(import "dyld-support.sb")

;; --- Process start -----------------------------------------------------------------
;; Only the bundled interpreter and its own libraries may be exec'd, and forking helper
;; processes is denied outright. Together these neutralize Java Runtime.exec, Node
;; child_process, and Python subprocess: there is nothing else to exec and no way to fork.
;; (Node worker_threads are in-process threads, not forks, so HTTP still works.)
(allow process-exec* (subpath (param "RESOURCES")))
(deny process-fork)

;; --- Host facts the runtimes query at startup --------------------------------------
;; These expose machine configuration, not user data, so they stay allowed while the
;; filesystem rules below keep user files confined.
(allow sysctl-read)
(allow mach-lookup)
(allow iokit-open)
(allow system-socket)

;; --- Networking --------------------------------------------------------------------
;; Outbound TCP to any host and any port (many sources serve their API on ports like
;; :8080 or :16968; a port limit adds nothing while :443 to any host is open), plus the
;; mDNSResponder socket that getaddrinfo uses to resolve host names, and loopback
;; bind/connect for the media proxy and cloud bridge.
(allow network-outbound
    (remote tcp "*:*")
    (remote ip "localhost:*")
    (literal "/private/var/run/mDNSResponder"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))

;; --- Filesystem --------------------------------------------------------------------
;; Metadata (existence/size/mtime of a node, i.e. stat/lstat) is allowed broadly: the
;; runtimes and getaddrinfo resolve real paths by stat'ing many directories, and metadata
;; alone leaks no file contents. File *contents* are a strict allowlist. The user's home
;; is then cut off entirely (even metadata), and only the app's own directories under it
;; are reopened -- so a spider cannot read or even stat ~/.ssh, ~/.zsh_history, Documents.
;;
;; Precedence note: Seatbelt lets a MORE-SPECIFIC operation rule beat a less-specific one
;; regardless of order, so a `file-read*` allow does NOT override an explicit
;; `file-read-metadata` deny. Every rule that must defeat the home deny below therefore
;; names `file-read-metadata` explicitly rather than relying on the `file-read*` wildcard.
(allow file-read-metadata)

;; Readable contents: system libraries/support and name resolution only (none under home).
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/System/Library")
    (subpath "/Library/Apple")
    (subpath "/private/etc")
    (subpath "/private/var/db/timezone")
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/random")
    (literal "/dev/urandom"))

;; Cut off the user's home directory: no contents, no metadata.
(deny file-read* file-read-metadata (subpath (param "HOME")))

;; Reopen exactly the app's own directories (the bundle may itself live under the home,
;; e.g. in DerivedData). The explicit `file-read-metadata` defeats the home deny's
;; metadata rule; the ancestor rule lets the runtimes traverse ~/Library/Caches to reach
;; the cache without exposing siblings such as ~/.ssh.
(allow file-read* file-read-metadata (subpath (param "RESOURCES")))
(allow file-read-metadata
    (path-ancestors (param "RESOURCES"))
    (path-ancestors (param "CACHE_ROOT"))
    (path-ancestors (param "JOB"))
    (path-ancestors (param "PROFILE"))
    (path-ancestors (param "ACCOUNTS")))
(allow file-read* file-read-metadata (literal (param "ACCOUNTS")))
(allow file-read* file-read-metadata file-write*
    (subpath (param "CACHE_ROOT"))
    (subpath (param "JOB"))
    (subpath (param "PROFILE")))
(allow file-write-data (literal "/dev/null"))
(allow file-ioctl (literal "/dev/null"))
