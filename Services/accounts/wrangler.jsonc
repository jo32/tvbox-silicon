{
  "$schema": "../../website/node_modules/wrangler/config-schema.json",
  "name": "yingxia-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "yingxia-accounts.getmegaportal.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    // People, sign-ins, sessions, codes and Pro time (schema.sql). Made with: wrangler d1 create yingxia-accounts
    { "binding": "DB", "database_name": "yingxia-accounts", "database_id": "86a2394e-62c8-424f-8fce-9e50975ae5ff" },
    // The error-reports database (Services/error-reports), only read: which install sent which feedback issue.
    { "binding": "REPORTS", "database_name": "yingxia-reports", "database_id": "1f9e0251-3a96-43ad-ad9a-bd818932aec0" }
  ],
  "ratelimits": [
    // Per IP address: signing in and starting a Telegram sign-in.
    { "name": "LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    // Per person: tries at a redeem code, in the app and in the bot.
    { "name": "REDEEM_LIMITER", "namespace_id": "4202", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "FEEDBACK_REPO": "jo32/tvbox-silicon",
    "APPLE_AUDIENCES": "com.jo32.yingxia.ios,com.jo32.yingxia.tv,com.jo32.yingxia.macos",
    "APPLE_TEAM_ID": "WWNM49L69R",
    "TELEGRAM_BOT": "yingxia_sup_bot",
    // Points (src/points.ts) for a day of use, a feedback message (at most 3 a day), an adopted one, a merged pull
    // request; Pro days an adopted message gives (0 = none). Pull requests by PR_EXCLUDE never earn points.
    "POINTS_DAILY": "1",
    "POINTS_SENT": "1",
    "POINTS_FIXED": "50",
    "POINTS_ADOPTED": "100",
    "POINTS_PR": "500",
    "REWARD_DAYS": "0",
    "PR_EXCLUDE": "jo32",
    // The admin pages' origins, comma-separated (CORS for /v1/admin/*).
    "ADMIN_ORIGINS": "",
    // TestFlight invitations through the bot's /tf (src/tf.ts): TF_DAILY places in Yingxia Beta open every day at
    // TF_OPEN_HOUR (UTC+8); lifetime Pro people get Yingxia Pro. Accepted mail domains; days before someone the cleanup
    // removed may ask again; the apps and their external groups ("Cloud Drive Browsing"); the codes' sender.
    "TF_DAILY": "100",
    "TF_OPEN_HOUR": "20",
    "TF_DOMAINS": "icloud.com,me.com,mac.com,gmail.com,googlemail.com",
    "TF_AGAIN_DAYS": "7",
    "TF_BETA_APP": "6838344462",
    "TF_BETA_GROUP": "b4477339-1186-4f71-9fec-e887f160af07",
    "TF_PRO_APP": "6838347717",
    "TF_PRO_GROUP": "a9f39cc2-71e0-45ee-9ada-77590ed40ff0",
    "TF_FROM": "yingxia@getmegaportal.com",
    "ASC_ISSUER": "cc097225-575e-4c18-837b-b44d6f57024f"
  },
  // Cloudflare Email Sending: the /tf codes. getmegaportal.com must be onboarded (Compute › Email Service).
  "send_email": [{ "name": "EMAIL" }],
  // The bot is @yingxia_sup_bot, whose Worker (jo32/yx-tg) passes account commands here.
  // Secrets (wrangler secret put …): ADMIN_TOKEN, ENTITLEMENT_KEY, TELEGRAM_WEBHOOK_SECRET (= yx-tg's ACCOUNTS_SECRET),
  // GITHUB_TOKEN (read-only is enough), and optionally APPLE_KEY_ID + APPLE_PRIVATE_KEY (revokes Apple sign-ins on deletion).
  // ASC_KEY_ID + ASC_PRIVATE_KEY: an App Store Connect API key (App Manager) that invites the /tf testers.
  // Every 15 minutes: copy new feedback, read its status and merged pull requests on GitHub.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": false }
}
